{
  "name": "assetgpu",
  "version": "1.0.0",
  "description": "JavaScript library for baking WGSL / WebGPU shaders into PNG, MP4, WAV and other assets.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "assetgpu": "./bin/assetgpu.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./image": "./src/image/encode-image.js",
    "./video": "./src/video/encode-video.js",
    "./audio": "./src/audio/encode-audio.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "javascript",
    "js",
    "library",
    "webgpu",
    "wgsl",
    "asset",
    "export",
    "png",
    "mp4",
    "wav",
    "shader",
    "compute-shader",
    "generative-art",
    "headless",
    "node",
    "ffmpeg",
    "sharp"
  ],
  "author": "uut12345qwert-collab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uut12345qwert-collab/assetgpu-js.git"
  },
  "bugs": {
    "url": "https://github.com/uut12345qwert-collab/assetgpu-js/issues"
  },
  "homepage": "https://github.com/uut12345qwert-collab/assetgpu-js#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "sharp": ">=0.32.0",
    "@ffmpeg-installer/ffmpeg": ">=1.1.0",
    "webgpu": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "sharp": { "optional": true },
    "@ffmpeg-installer/ffmpeg": { "optional": true },
    "webgpu": { "optional": true }
  }
}
